{
  "name": "daily-qa-briefing",
  "version": "1.0.0",
  "description": "Daily QA Intelligence Briefing using Playwright - UI + API automation",
  "scripts": {
    "test": "playwright test",
    "test:unit": "jest --passWithNoTests",
    "test:api": "playwright test tests/api/",
    "test:ui": "playwright test tests/ui/",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "stocks": "node stock-report/run.js",
    "stocks:demo": "STOCK_DEMO=1 node stock-report/run.js"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests/unit"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "jest": "^29.6.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.6.0"
  }
}
